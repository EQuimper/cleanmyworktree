---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/martian-mono/index.css';
import '../styles/shared.css';
import '../styles/site.css';
import { brewInstall, repo, version } from '../lib/release';

const title = 'cmw: fast, disk-cheap git worktrees for humans and AI agents';
const description =
  'cmw creates git worktrees with dependencies already in place. node_modules, Pods and vendor are copy-on-write clones of your main checkout, so each worktree is ready in seconds and costs almost no disk.';
const image = new URL('/og.png', Astro.site);

const wt = '~/.cmw/worktrees/shop';

type Seg = [text: string, cls?: string];
type Line = { cls: string; segs: Seg[] };
const cmd = (text: string): Line => ({ cls: 'line', segs: [['$ ', 'prompt'], [text, 'cmd']] });
const out = (...segs: (string | Seg)[]): Line => ({
  cls: 'line',
  segs: segs.map((s) => (typeof s === 'string' ? [s] : s)),
});
const dim = (text: string): Line => ({ cls: 'line dim', segs: [[text]] });
const err = (text: string): Line => ({ cls: 'line err', segs: [[text]] });

const sessions: { id: string; lines: Line[] }[] = [
  {
    id: 'new',
    lines: [
      cmd('cmw new feat/login'),
      out(`hydrated ${wt}/feat-login in 1.6s: 3 cloned, 2 copied, 4 skipped; installs: 1 up to date; `, ['ready', 'ok']),
      out(`${wt}/feat-login`),
      cmd('cmw cd feat/login'),
    ],
  },
  {
    id: 'ls',
    lines: [
      cmd('cmw ls'),
      out('shop (~/code/shop/.git)'),
      dim('BRANCH        STATE    MERGED  IDLE  HYDRATED  PATH'),
      out('main [main]   clean    ?       0d    no        ~/code/shop'),
      out(`feat/login    clean    no      0d    yes       ${wt}/feat-login`),
      out(`fix/checkout  2 dirty  no      1d    yes       ${wt}/fix-checkout`),
      out(`spike/search  clean    `, ['yes', 'ok'], `     23d   yes       ${wt}/spike-search`),
    ],
  },
  {
    id: 'gc',
    lines: [
      cmd('cmw gc'),
      out('would remove 1 merged worktree(s):'),
      out(`  spike/search  [gh]  ${wt}/spike-search`),
      dim('run: cmw gc --yes'),
      cmd('cmw gc --yes'),
      out('removed 1 merged worktree(s):'),
      out(`  spike/search  [gh, branch deleted]  ${wt}/spike-search`),
      out(['freed ~2.1 GB', 'ok'], ' (change in free disk space)'),
    ],
  },
];

const refused: Line[] = [
  cmd('cmw rm fix/checkout'),
  err(`error: 2 uncommitted changes in ${wt}/fix-checkout`),
  out('  fix: ', ['cmw rm fix/checkout --force', 'ok']),
  dim('exit 3'),
];

const json: Line[] = [
  cmd('cmw new fix/flaky-test --json'),
  out('{'),
  out('  "ok": ', ['true', 'ok'], ','),
  out('  "command": "new",'),
  out('  "data": {'),
  out(`    "path": "${wt}/fix-flaky-test",`),
  out('    "hydrate": { "ready": ', ['true', 'ok'], ', "needs_setup": [] }'),
  out('  },'),
  out('  "warnings": []'),
  out('}'),
];

const strategies = [
  {
    name: 'clone',
    text: 'Dependencies move safely, so they are cloned copy-on-write. Instant, and free until a file changes.',
    examples: ['node_modules', 'Pods', 'vendor', 'target', '.turbo'],
  },
  {
    name: 'copy',
    text: 'Secrets and machine-local config. Each worktree gets its own copy.',
    examples: ['.env*', 'local.properties', 'google-services.json', '*.keystore'],
  },
  {
    name: 'regen',
    text: 'Holds absolute paths. A cloned venv would install into main’s, so it is rebuilt.',
    examples: ['.venv', '.dart_tool'],
  },
  {
    name: 'skip',
    text: 'Build output tied to the original path. Left behind, and cleaned up later.',
    examples: ['DerivedData', '.cxx', 'build/', '.next', '.expo'],
  },
];

const stacks = ['npm', 'pnpm', 'yarn', 'bun', 'CocoaPods', 'SPM', 'Gradle', 'Expo', 'React Native', 'Composer', 'uv', 'poetry', 'Cargo'];

const contract = [
  ['--json', 'One JSON document on stdout, every command.'],
  ['exit codes', '0 ok · 1 error · 2 usage · 3 refused · 4 not found'],
  ['no prompts', 'Never reads stdin. Destructive commands are dry runs until --yes.'],
  ['fix hints', 'Every refusal names the exact command that resolves it.'],
  ['idempotent', 'Re-run new or hydrate any time. Same branch, same path.'],
  ['parallel-safe', 'A lock per repo serializes concurrent runs.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4ef2a0" />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="hero">
      <nav class="bar" aria-label="Main">
        <a class="brand" href="/">
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <g fill="none" stroke="currentColor" stroke-linecap="round">
              <path d="M40.5 18.5A17 17 0 1 0 40.5 45.5" stroke-width="6.5"></path>
              <circle cx="43" cy="47" r="5.5" stroke-width="5"></circle>
            </g>
            <circle cx="43" cy="17" r="7" fill="currentColor"></circle>
          </svg>
          cmw
        </a>
        <a href="/docs/">Docs</a>
        <a href={repo}>GitHub</a>
      </nav>

      <h1>Worktrees in seconds, not gigabytes.</h1>

      <div class="pitch">
        <p>cmw creates git worktrees with dependencies already in place. <code>node_modules</code>, Pods and <code>vendor</code> are copy-on-write clones of your main checkout.</p>
      </div>

      <div class="get">
        <div class="command">
          <code>{brewInstall}</code>
          <button type="button" data-copy={brewInstall}>Copy</button>
        </div>
        <a class="docs-link" href="/docs/">Read the docs</a>
      </div>

      <section class="term" aria-label="Example cmw session">
        <div class="term-bar">
          <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <div class="tabs" role="tablist" aria-label="Command">
            {
              sessions.map((s, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${s.id}`}
                  aria-controls={`panel-${s.id}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? 0 : -1}
                  data-tab={s.id}
                >
                  cmw {s.id}
                </button>
              ))
            }
          </div>
        </div>
        {
          sessions.map((s, index) => (
            <div class="screen" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={index > 0} tabindex="0">
              {s.lines.map((l) => <span class={l.cls}>{l.segs.map(([t, c]) => (c ? <span class={c}>{t}</span> : t))}</span>)}
            </div>
          ))
        }
      </section>
    </header>

    <main>
      <section class="band stats" aria-label="Numbers">
        <div>
          <strong>1.6 s</strong>
          <p>to clone a 1.4 GB <code>node_modules</code> with 107k files</p>
        </div>
        <div>
          <strong>~0 B</strong>
          <p>extra disk until a file changes in the worktree</p>
        </div>
        <div>
          <strong>0</strong>
          <p>installs when the lockfile matches main</p>
        </div>
      </section>

      <section class="band hydrate" aria-labelledby="hydrate-title">
        <h2 id="hydrate-title">Every ignored file lands where it should</h2>
        <div class="strategies">
          {
            strategies.map((s) => (
              <article>
                <h3>
                  <span class="tag">{s.name}</span>
                </h3>
                <p>{s.text}</p>
                <ul>
                  {s.examples.map((e) => (
                    <li>
                      <code>{e}</code>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
        <ul class="stacks" aria-label="Supported tools">
          {stacks.map((s) => <li>{s}</li>)}
        </ul>
        <a class="more" href="/docs/hydrate/">How hydrate works</a>
      </section>

      <section class="band safe" aria-labelledby="safe-title">
        <div class="safe-text">
          <h2 id="safe-title">Cleanup that keeps your work</h2>
          <ul>
            <li>Refuses uncommitted changes and unpushed commits unless you pass <code>--force</code>.</li>
            <li>Deletes a branch only when git, patch IDs or <code>gh</code> prove it merged.</li>
            <li>Takes the DerivedData, <code>.cxx</code> and build caches with the worktree.</li>
            <li>Reports space freed from the disk itself, not from <code>du</code>.</li>
          </ul>
          <a class="more" href="/docs/cleanup/">Learn the cleanup rules</a>
        </div>
        <div class="term term-solo screen" role="region" tabindex="0" aria-label="cmw refusing to remove a worktree with uncommitted changes">
          {refused.map((l) => <span class={l.cls}>{l.segs.map(([t, c]) => (c ? <span class={c}>{t}</span> : t))}</span>)}
        </div>
      </section>

      <section class="band agents" aria-labelledby="agents-title">
        <h2 id="agents-title">Built for agents</h2>
        <div class="agents-grid">
          <dl>
            {
              contract.map(([term, text]) => (
                <div>
                  <dt>
                    <code>{term}</code>
                  </dt>
                  <dd>{text}</dd>
                </div>
              ))
            }
          </dl>
          <div class="agents-code">
            <div class="term term-solo screen" role="region" tabindex="0" aria-label="JSON output of cmw new">
              {json.map((l) => <span class={l.cls}>{l.segs.map(([t, c]) => (c ? <span class={c}>{t}</span> : t))}</span>)}
            </div>
            <div class="teach">
              <div class="command dark">
                <code>cmw skill install</code>
                <button type="button" data-copy="cmw skill install">Copy</button>
              </div>
              <p>Installs a Claude Code skill. <code>cmw hook claude</code> routes Claude Code worktrees through cmw.</p>
            </div>
          </div>
        </div>
        <a class="more" href="/docs/agents/">Use cmw with agents</a>
      </section>
    </main>

    <footer class="band end">
      <h2>Install cmw</h2>
      <div class="command">
        <code>{brewInstall}</code>
        <button type="button" data-copy={brewInstall}>Copy</button>
      </div>
      <p>Version {version}. macOS on Apple silicon and Intel. Free and open source under the MIT License.</p>
      <nav aria-label="Footer">
        <a href="/docs/">Docs</a>
        <a href={repo}>GitHub</a>
        <a href={`${repo}/releases`}>Releases</a>
        <a href="https://equimper.com">Created by Emanuel Quimper</a>
      </nav>
    </footer>

    <script>
      import '../scripts/page';
    </script>
  </body>
</html>
