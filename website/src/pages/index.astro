---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/martian-mono/index.css';
import '../styles/shared.css';
import '../styles/site.css';
import Branch from '../components/Branch.astro';
import Duel from '../components/Duel.astro';
import Playground from '../components/Playground.astro';
import og from '../assets/og.png';
import { agentPrompt, brewInstall, repo, version } from '../lib/release';

const title = 'cmw: fast, disk-cheap git worktrees for humans and AI agents';
const description =
  'cmw fills new git worktrees with your node_modules, Pods and .env as copy-on-write clones of your main checkout. Ready in seconds, almost no extra disk, and cleanup that never loses work.';
const image = new URL(og.src, Astro.site);

const wt = '~/.cmw/worktrees/shop';

const gaps = [
  {
    missing: 'Dependencies',
    without: 'node_modules, Pods and vendor aren’t there. Reinstalling takes minutes and a full copy on disk.',
    with: 'Cloned from your main checkout in seconds. If the lockfile matches, nothing installs.',
  },
  {
    missing: 'Secrets',
    without: '.env, local.properties and keystores are gitignored, so they don’t come along.',
    with: 'Copied into the worktree. cmw env sync refreshes them after you change one.',
  },
  {
    missing: 'Cleanup',
    without: 'Deleting the folder leaves DerivedData, .cxx and build caches behind.',
    with: 'cmw rm removes the worktree, its caches, and the branch once it’s merged.',
  },
];

const tree = [
  { path: 'node_modules/', strategy: 'clone', why: 'Works from any path, so it’s cloned' },
  { path: 'ios/Pods/', strategy: 'clone', why: 'Same, for CocoaPods' },
  { path: '.env.local', strategy: 'copy', why: 'Each worktree gets its own copy' },
  { path: 'android/local.properties', strategy: 'copy', why: 'Machine-local config' },
  { path: '.venv/', strategy: 'regen', why: 'Holds absolute paths, so it’s rebuilt' },
  { path: '.next/', strategy: 'skip', why: 'Rebuilt on the first run' },
  { path: 'ios/DerivedData/', strategy: 'skip', why: 'Tied to the original path' },
];

const contract = [
  ['--json', 'One JSON document on stdout, for every command.'],
  ['Exit codes', '0 ok, 1 error, 2 usage, 3 refused, 4 not found.'],
  ['No prompts', 'Never reads stdin. Destructive commands are dry runs until --yes.'],
  ['Fix hints', 'Every refusal names the command that resolves it.'],
  ['Idempotent', 'Run new or hydrate again any time. Same branch, same path.'],
  ['Parallel-safe', 'A lock per repo serializes concurrent runs.'],
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'cmw',
  alternateName: 'cleanmyworktree',
  description,
  url: Astro.site,
  image: image.href,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux',
  softwareVersion: version,
  license: 'https://opensource.org/licenses/MIT',
  downloadUrl: `${repo}/releases`,
  installUrl: new URL('/docs/install/', Astro.site).href,
  softwareHelp: { '@type': 'CreativeWork', url: new URL('/docs/', Astro.site).href },
  sameAs: [repo],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Emanuel Quimper', url: 'https://equimper.com' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4ef2a0" />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={og.width} />
    <meta property="og:image:height" content={og.height} />
    <meta property="og:image:alt" content="cmw: Worktrees in seconds, not gigabytes. brew install equimper/tap/cmw" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <header class="hero stop">
      <nav class="bar" aria-label="Main">
        <a class="brand" href="/">
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <g fill="none" stroke="currentColor" stroke-linecap="round">
              <path d="M40.5 18.5A17 17 0 1 0 40.5 45.5" stroke-width="6.5"></path>
              <circle cx="43" cy="47" r="5.5" stroke-width="5"></circle>
            </g>
            <circle cx="43" cy="17" r="7" fill="currentColor"></circle>
          </svg>
          cmw
        </a>
        <a href="/docs/">Docs</a>
        <a href={repo}>GitHub</a>
      </nav>

      <h1 class="node filled">Worktrees in seconds, not gigabytes.</h1>

      <p class="lede">
        <code>git worktree</code> gives you a second checkout of your repo, but not its <code>node_modules</code>, Pods or <code>.env</code>. cmw brings them over from your main checkout as copy-on-write clones.
      </p>

      <div class="get">
        <div class="command">
          <code>{brewInstall}</code>
          <button type="button" data-copy={brewInstall}>Copy</button>
        </div>
        <button type="button" class="prompt-copy" data-copy={agentPrompt}>Copy agent prompt</button>
        <a class="prompt-copy try-link" href="#try">Try it in your browser</a>
        <a class="docs-link" href="/docs/">Read the docs</a>
      </div>

      <Duel />
    </header>

    <main>
      <section id="try" class="stop try" aria-labelledby="try-title">
        <h2 id="try-title" class="node">Try it in your browser</h2>
        <Playground />
        <Branch />
      </section>

      <section class="stop gaps" aria-labelledby="gaps-title">
        <h2 id="gaps-title" class="node">A new worktree starts empty</h2>
        <div class="compare" role="table" aria-label="What a new worktree is missing">
          <div class="compare-head" role="row">
            <span role="columnheader"><span class="sr-only">Missing</span></span>
            <span role="columnheader"><code>git worktree add</code></span>
            <span role="columnheader"><code>cmw new</code></span>
          </div>
          {
            gaps.map((g) => (
              <div class="compare-row" role="row">
                <h3 role="rowheader">{g.missing}</h3>
                <p class="without" role="cell"><code class="m-label">git worktree add</code>{g.without}</p>
                <p class="with" role="cell"><code class="m-label">cmw new</code>{g.with}</p>
              </div>
            ))
          }
        </div>
        <Branch />
      </section>

      <section class="stop cow" aria-labelledby="cow-title">
        <h2 id="cow-title" class="node">Clones share disk until a file changes</h2>
        <p class="body">
          A copy-on-write clone points at the same disk blocks as the original. Ten worktrees with a 1.4 GB <code>node_modules</code> use about 1.4 GB, not 14. Install a package in one of them and only that package takes new space.
        </p>

        <figure class="blocks" data-reveal aria-label="Two checkouts pointing at the same disk blocks, with one new block for new-lib">
          <div class="checkouts">
            <div class="checkout">
              <p class="where"><code>~/code/shop</code></p>
              <p class="dep">node_modules</p>
            </div>
            <div class="checkout">
              <p class="where"><code>{wt}/feat-login</code></p>
              <p class="dep">node_modules <span class="plus">+ new-lib</span></p>
            </div>
          </div>
          <svg class="wires" viewBox="0 0 100 200" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 50 C 50 50, 50 90, 100 90"></path>
            <path d="M0 150 C 50 150, 50 90, 100 90"></path>
            <path class="own" d="M0 150 C 60 150, 60 182, 100 182"></path>
          </svg>
          <div class="disk">
            <div class="grid" aria-hidden="true">
              {Array.from({ length: 40 }, (_, i) => <i style={`--i:${i}`} />)}
            </div>
            <p>1.4 GB, stored once</p>
            <div class="new">
              <i aria-hidden="true"></i>
              <p><code>new-lib</code> is the only new data</p>
            </div>
          </div>
        </figure>

        <p class="aside">
          <code>du</code> and Finder count every clone at full size. cmw measures what it frees from the disk itself. <a href="/docs/disk/">Disk usage</a>
        </p>
        <Branch />
      </section>

      <section class="stop rules" aria-labelledby="rules-title">
        <h2 id="rules-title" class="node">Every ignored file gets the right treatment</h2>
        <p class="body">For each gitignored path in your main checkout, cmw asks one question: does it still work from another folder?</p>

        <div class="tree" role="table" aria-label="How cmw handles ignored files in an example repo">
          <div class="tree-root" role="row"><code role="cell">shop/</code></div>
          {
            tree.map((t, i) => (
              <div class="tree-row" role="row">
                <code class="path" role="cell"><span class="branch" aria-hidden="true">{i === tree.length - 1 ? '└─ ' : '├─ '}</span>{t.path}</code>
                <span class="strategy" role="cell"><span class={`tag ${t.strategy}`}>{t.strategy}</span></span>
                <span class="why" role="cell">{t.why}</span>
              </div>
            ))
          }
        </div>

        <p class="body">
          Then cmw compares each lockfile with main’s. If it matches, nothing installs. If it differs, cmw runs your usual install with npm, pnpm, yarn, bun, Composer, CocoaPods, uv or poetry. Add your own rules in <code>.cmw.toml</code>.
        </p>
        <a class="more" href="/docs/hydrate/">How hydrate works</a>
        <Branch />
      </section>

      <section class="stop safe" aria-labelledby="safe-title">
        <h2 id="safe-title" class="node">Cleanup that keeps your work</h2>
        <div class="split">
          <ul class="checks">
            <li>Refuses to delete uncommitted changes or unpushed commits unless you pass <code>--force</code>.</li>
            <li>Deletes a branch only when git, patch IDs or <code>gh</code> prove it’s merged.</li>
            <li>Removes DerivedData, <code>.cxx</code> and build caches along with the worktree.</li>
            <li><code>cmw gc</code> shows what it would remove. Nothing happens until <code>--yes</code>.</li>
          </ul>
          <div class="term" data-reveal role="region" tabindex="0" aria-label="cmw refusing to remove a worktree with uncommitted changes, then cleaning up merged worktrees">
            <span class="line"><span class="prompt">$ </span><span class="cmd">cmw rm fix/checkout</span></span>
            <span class="line err">error: 2 uncommitted changes in {wt}/fix-checkout</span>
            <span class="line">  fix: cmw rm fix/checkout --force</span>
            <span class="line gap"><span class="prompt">$ </span><span class="cmd">cmw gc --yes</span></span>
            <span class="line">removed 1 merged worktree(s):</span>
            <span class="line">  spike/search  [gh, branch deleted]</span>
            <span class="line"><span class="ok">freed ~2.1 GB</span> (change in free disk space)</span>
          </div>
        </div>
        <a class="more" href="/docs/cleanup/">Cleanup rules</a>
        <Branch />
      </section>

      <section class="stop agents" aria-labelledby="agents-title">
        <h2 id="agents-title" class="node">Built for agents</h2>
        <p class="body">Claude Code, Codex, Grok and T3 Code can create, use and remove worktrees with cmw without asking you anything.</p>
        <div class="split">
          <dl>
            {
              contract.map(([term, text]) => (
                <div>
                  <dt>{term}</dt>
                  <dd>{text}</dd>
                </div>
              ))
            }
          </dl>
          <div>
            <div class="term" data-reveal role="region" tabindex="0" aria-label="JSON output of cmw new">
              <span class="line"><span class="prompt">$ </span><span class="cmd">cmw new fix/flaky-test --json</span></span>
              <span class="line">{'{'} "ok": <span class="ok">true</span>, "command": "new",</span>
              <span class="line">  "data": {'{'}</span>
              <span class="line">    "path": "{wt}/fix-flaky-test",</span>
              <span class="line">    "hydrate": {'{'} "ready": <span class="ok">true</span>, "needs_setup": [] {'}'}</span>
              <span class="line">  {'}'}, "warnings": [] {'}'}</span>
            </div>
            <div class="teach">
              <p>
                Paste the prompt into your agent. It installs cmw and the cmw skill, and in T3 Code it runs <code>cmw hydrate</code> on every new worktree.
              </p>
              <button type="button" class="prompt-copy" data-copy={agentPrompt}>Copy agent prompt</button>
              <details>
                <summary>Read the prompt</summary>
                <pre>{agentPrompt}</pre>
              </details>
            </div>
          </div>
        </div>
        <a class="more" href="/docs/agents/">Use cmw with agents</a>
        <Branch />
      </section>
    </main>

    <footer class="stop end">
      <h2 class="node filled">Install cmw</h2>
      <div class="command">
        <code>{brewInstall}</code>
        <button type="button" data-copy={brewInstall}>Copy</button>
      </div>
      <button type="button" class="prompt-copy" data-copy={agentPrompt}>Copy agent prompt</button>
      <p>Version {version} for macOS and Linux on ARM64 and x86-64. Free and open source under the MIT License.</p>
      <nav aria-label="Footer">
        <a href="/docs/">Docs</a>
        <a href={repo}>GitHub</a>
        <a href={`${repo}/releases`}>Releases</a>
        <a href="https://equimper.com">Created by Emanuel Quimper</a>
      </nav>
    </footer>

    <script>
      import '../scripts/page';
    </script>
  </body>
</html>
