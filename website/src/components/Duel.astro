---
import { sessions } from '../lib/duel';
---

<figure class="duel" data-duel aria-label="Setting up the same worktree with plain git and with cmw">
  <div class="ttys">
    {
      sessions.map((s) => (
        <div class={`tty ${s.id}`} data-tty={s.id} data-steps={JSON.stringify(s.steps)}>
          <div class="tty-bar">
            <span class="lights" aria-hidden="true"><i /><i /><i /></span>
            <span class="tty-title">{s.title}</span>
            <span class="ff" data-ff hidden>▶▶ 30×</span>
            <span class="clock" data-clock>{s.finalClock}</span>
          </div>
          <div class="tty-screen" data-screen>
            {s.steps.map((step) =>
              'cmd' in step ? (
                <span class="line"><span class="prompt">{step.prompt} </span><span class="cmd">{step.cmd}</span></span>
              ) : 'out' in step ? (
                <span class="line out">{step.out}{step.ok && <span class="ok">{step.ok}</span>}</span>
              ) : 'idle' in step ? (
                <span class="line"><span class="prompt">{step.idle} </span><span class="cursor" /></span>
              ) : null,
            )}
          </div>
          <p class="tty-foot">{s.disk}</p>
        </div>
      ))
    }
  </div>
  <figcaption>
    <span>cmw measured on a 1.4 GB node_modules with 107k files, on APFS. The npm install time is an example; yours depends on your machine and network.</span>
    <button type="button" class="replay" data-replay>Replay</button>
  </figcaption>
</figure>

<script>
  import '../scripts/duel';
</script>
